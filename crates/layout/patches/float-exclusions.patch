+    /// The floats that intersect a box below its top at `y_offset`, with the passed insets from
+    /// the edges of the Block Formatting Context: `[top, bottom, left, right]`, where `top` and
+    /// `bottom` are relative to the top of the box, and `left` and `right` are how far floats
+    /// extend into the box from each side
+    pub fn exclusions(&self, y_offset: f32, insets: [f32; 2]) -> Vec<[f32; 4]> {
+        self.segments
+            .iter()
+            .filter(|segment| segment.y.end > y_offset)
+            .filter_map(|segment| {
+                let left = if segment.has_float[0] { (segment.insets[0] - insets[0]).max(0.0) } else { 0.0 };
+                let right = if segment.has_float[1] { (segment.insets[1] - insets[1]).max(0.0) } else { 0.0 };
+                (left > 0.0 || right > 0.0).then(|| [segment.y.start - y_offset, segment.y.end - y_offset, left, right])
+            })
+            .collect()
+    }
