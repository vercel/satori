 impl FlexItem {
+    /// Transfers an outer cross size through the aspect ratio to an outer main size
+    fn transfer_cross_size(&self, cross: Option<f32>, dir: FlexDirection) -> Option<f32> {
+        let ratio = self.aspect_ratio?;
+        let cross = cross? - self.box_sizing_adjustment.cross(dir);
+        let main = if dir.is_row() { cross * ratio } else { cross / ratio };
+        Some(main + self.box_sizing_adjustment.main(dir))
+    }
+
+    /// Transfers an outer main size through the aspect ratio to an outer cross size
+    fn transfer_main_size(&self, main: f32, dir: FlexDirection) -> Option<f32> {
+        let ratio = self.aspect_ratio?;
+        let main = main - self.box_sizing_adjustment.main(dir);
+        let cross = if dir.is_row() { main / ratio } else { main * ratio };
+        Some(cross + self.box_sizing_adjustment.cross(dir))
+    }
